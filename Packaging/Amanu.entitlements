<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The hardened runtime is required for notarization, and it closes the
         microphone unless the app says out loud that it needs one. System
         audio is not an entitlement: it is a TCC grant, asked for at runtime. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- The calendar is closed the same way, and it fails far more quietly:
         without this, `requestFullAccessToEvents` returns false immediately,
         with no error and no system prompt, and the setup window's Calendar
         button looks like a button that does nothing. -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
</dict>
</plist>
