<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The hardened runtime is required for notarization, and it closes the
         microphone unless the app says out loud that it needs one. System
         audio is not an entitlement: it is a TCC grant, asked for at runtime. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
