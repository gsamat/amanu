<Window x:Class="Amanu.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Amanu.App"
        Title="Amanu" Width="1120" Height="780" MinWidth="900" MinHeight="640"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}" WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,18">
      <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="14" Background="{DynamicResource Primary}"><TextBlock Text="A" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource ButtonText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Margin="13,0,0,0"><TextBlock Text="Amanu" FontSize="23" FontWeight="Bold"/><TextBlock Text="Windows · записи, транскрипты и итоги встреч" Foreground="{DynamicResource MutedText}"/></StackPanel>
      <Button x:Name="PauseButton" DockPanel.Dock="Right" Content="Пауза" Click="PauseButton_Click" MinWidth="95" IsEnabled="False"/>
      <Button x:Name="RecordButton" DockPanel.Dock="Right" Content="Начать запись" Click="RecordButton_Click" MinWidth="150"/>
    </DockPanel>
    <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
      <DockPanel><TextBlock x:Name="StatusText" Text="Готово" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="ElapsedText" DockPanel.Dock="Right" FontFamily="Consolas" FontSize="18"/><TextBlock x:Name="DetailText" Text="Ожидаю звонок в настроенном приложении" Foreground="{DynamicResource MutedText}" Margin="14,0,0,0" VerticalAlignment="Center"/></DockPanel>
    </Border>
    <TabControl Grid.Row="2" x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">
      <TabItem Header="Запись"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <Border Background="{DynamicResource PanelBackground}" CornerRadius="16" Padding="22" Margin="0,0,0,16"><StackPanel>
            <TextBlock Text="Автоматическая запись" FontSize="19" FontWeight="SemiBold"/><CheckBox x:Name="AutoRecordCheckBox" Content="Записывать звонки автоматически" Click="AutoRecordCheckBox_Click"/><CheckBox x:Name="StartupCheckBox" Content="Запускать Amanu при входе в Windows" Click="StartupCheckBox_Click"/>
            <TextBlock Text="Микрофон и звук приложения сохраняются раздельно. Для браузеров Windows иногда может захватывать весь процесс, а не одну вкладку." TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,10,0,0"/>
          </StackPanel></Border>
          <Border Background="{DynamicResource PanelBackground}" CornerRadius="16" Padding="22"><StackPanel><TextBlock Text="Текущая обработка" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="ProcessingText" Text="Очередь пуста" TextWrapping="Wrap" Margin="0,10,0,0"/><ProgressBar x:Name="ProcessingProgress" Height="6" Margin="0,12,0,0" IsIndeterminate="False" Visibility="Collapsed"/></StackPanel></Border>
        </StackPanel>
        <Border Grid.Column="2" Background="{DynamicResource PanelBackground}" CornerRadius="16" Padding="22"><StackPanel><TextBlock Text="Live-транскрипт" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Появляется во время записи, если live-режим включён в настройках." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,12"/><TextBox x:Name="LiveTranscriptText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="300" VerticalScrollBarVisibility="Auto"/></StackPanel></Border>
      </Grid></ScrollViewer></TabItem>
      <TabItem Header="Записи"><Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><Button Content="Импортировать аудио или видео" Click="ImportButton_Click"/><Button Content="Обновить" Click="RefreshSessionsButton_Click"/><Button Content="Открыть папку" Click="OpenRecordingsButton_Click"/></StackPanel>
        <DataGrid x:Name="SessionsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="SessionsGrid_SelectionChanged" Margin="0,8" Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource TextPrimary}" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
          <DataGrid.Columns><DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Дата" Binding="{Binding StartedAt, StringFormat={}{0:g}}" Width="150"/><DataGridTextColumn Header="Длительность, с" Binding="{Binding DurationSeconds}" Width="105"/><DataGridTextColumn Header="Транскрипт" Binding="{Binding Transcript}" Width="95"/><DataGridTextColumn Header="Итог" Binding="{Binding Summary}" Width="80"/><DataGridTextColumn Header="Имена" Binding="{Binding NamedSpeakerCount}" Width="65"/><DataGridTextColumn Header="Движок" Binding="{Binding Engine}" Width="95"/></DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="2"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button Content="Открыть сессию" Click="OpenSelectedSessionButton_Click"/><Button Content="Воспроизвести аудио" Click="PlayAudioButton_Click"/><Button Content="Сделать транскрипт заново" Click="RetranscribeButton_Click"/><Button Content="Повторить имена и итог" Click="ReprocessButton_Click"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox x:Name="SpeakerLabelText" Width="90" ToolTip="Метка, например speaker_0"/><TextBox x:Name="SpeakerNameText" Width="150" ToolTip="Имя спикера"/><Button Content="Сохранить имя" Click="SaveSpeakerButton_Click"/></StackPanel></DockPanel>
        <TabControl Grid.Row="3" Margin="0,8,0,0"><TabItem Header="Итог"><TextBox x:Name="SummaryText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></TabItem><TabItem Header="Транскрипт"><TextBox x:Name="TranscriptText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></TabItem></TabControl>
      </Grid></TabItem>
      <TabItem Header="Настройки">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TabControl>
            <TabItem Header="Настройка">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <local:SetupForm x:Name="SettingsForm"/>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="Дополнительно">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="24">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Запись" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Ваше имя для дорожки микрофона"/>
                    <TextBox x:Name="UserNameText"/>
                    <CheckBox x:Name="MicrophoneActivityCheckBox" Content="Начинать, когда приложение звонка занимает микрофон"/>
                    <TextBlock Text="Задержка старта, сек"/><TextBox x:Name="StartDelayText"/>
                    <TextBlock Text="Задержка остановки, сек"/><TextBox x:Name="StopDelayText"/>
                    <TextBlock Text="Минимальная длительность, сек"/><TextBox x:Name="MinimumDurationText"/>
                    <TextBlock Text="Остановить после тишины, мин"/><TextBox x:Name="SilenceStopText"/>
                    <TextBlock Text="Максимальная длительность, мин"/><TextBox x:Name="MaximumDurationText"/>
                    <TextBlock Text="Приложения звонков, по одному на строку"/>
                    <TextBox x:Name="CallAppsText" AcceptsReturn="True" Height="120" VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Text="Игнорировать процессы, по одному на строку"/>
                    <TextBox x:Name="IgnoreAppsText" AcceptsReturn="True" Height="75"/>

                    <TextBlock Text="Расшифровка" Style="{StaticResource SectionTitle}" Margin="0,24,0,8"/>
                    <TextBlock Text="OpenAI transcription model"/><TextBox x:Name="OpenAiTranscriptionModelText"/>
                    <CheckBox x:Name="EchoFilterCheckBox" Content="Фильтровать эхо в транскрипте"/>
                    <CheckBox x:Name="OfflineEchoCheckBox" Content="Offline echo cancellation"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Имена и итоги" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Backend имён"/>
                    <ComboBox x:Name="SpeakerBackendCombo"><ComboBoxItem Content="auto"/><ComboBoxItem Content="openai"/><ComboBoxItem Content="anthropic"/><ComboBoxItem Content="ollama"/></ComboBox>
                    <TextBlock Text="Модель для имён (пусто = модель итога)"/><TextBox x:Name="SpeakerModelText"/>
                    <TextBlock Text="OpenAI summary model"/><TextBox x:Name="SummaryOpenAiModelText"/>
                    <TextBlock Text="Anthropic summary model"/><TextBox x:Name="SummaryAnthropicModelText"/>
                    <TextBlock Text="Язык итога (пусто = язык разговора)"/><TextBox x:Name="SummaryLanguageText"/>
                    <TextBlock Text="Инструкция для итога"/>
                    <TextBox x:Name="SummaryTemplateText" AcceptsReturn="True" TextWrapping="Wrap" Height="260" VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Text="Команда после обработки" Margin="0,20,0,0"/><TextBox x:Name="HookExecutableText"/>
                    <TextBlock Text="Аргументы, по одному на строку; {session} = папка"/>
                    <TextBox x:Name="HookArgumentsText" AcceptsReturn="True" Height="75"/>
                  </StackPanel>
                </Grid>
              </ScrollViewer>
            </TabItem>
          </TabControl>
          <Border Grid.Row="1" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="12,10,12,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Сохранить настройки" Click="SaveSettingsButton_Click"
                      Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
              <TextBlock x:Name="SettingsStatusText" Foreground="{DynamicResource MutedText}"
                         Text="Настройки первого запуска и приложения сохраняются вместе."
                         VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Диагностика"><StackPanel Margin="22"><TextBlock Text="Состояние Amanu" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="DiagnosticsText" Margin="0,12,0,12" TextWrapping="Wrap" FontFamily="Consolas"/><WrapPanel><Button Content="Настройки микрофона Windows" Click="PrivacyButton_Click"/><Button Content="Открыть config.json" Click="OpenConfigButtonButton_Click"/><Button Content="Открыть папку записей" Click="OpenRecordingsButton_Click"/></WrapPanel></StackPanel></TabItem>
    </TabControl>
    <TextBlock Grid.Row="3" x:Name="RecoveryText" Margin="0,10,0,0" Foreground="{DynamicResource MutedText}"/>
  </Grid>
</Window>
