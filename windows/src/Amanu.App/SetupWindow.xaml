<Window x:Class="Amanu.App.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Amanu.App"
        Title="Первая настройка amanu" Width="980" Height="760" MinWidth="760" MinHeight="520"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <local:SetupForm x:Name="Form"/>
    </ScrollViewer>
    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
            Background="{DynamicResource WindowBackground}" Padding="24,13">
      <DockPanel LastChildFill="True">
        <Button x:Name="FinishButton" DockPanel.Dock="Right" Content="Готово"
                Style="{StaticResource PrimaryButton}" MinWidth="110" Click="FinishButton_Click"
                Margin="8,0,0,0" IsDefault="True"/>
        <Button DockPanel.Dock="Right" Content="Позже" Click="LaterButton_Click" Margin="8,0,0,0"/>
        <TextBlock Text="Настройки можно изменить позже."
                   Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
