+int wmain(int argc, wchar_t ** wide_argv) {
+    // Windows narrow argv uses the ANSI code page, while the library ABI and
+    // UTF-8 batch-file contents require UTF-8. Preserve every argument before
+    // parsing, including model/audio paths and prompt text.
+    std::vector<std::string> utf8_args;
+    utf8_args.reserve(argc);
+    for (int i = 0; i < argc; ++i) {
+        const int size = WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, wide_argv[i], -1,
+                                            nullptr, 0, nullptr, nullptr);
+        if (size == 0) {
+            std::fprintf(stderr, "error: command-line argument is not valid Unicode\n");
+            return EXIT_FAILURE;
+        }
+        std::string argument(static_cast<size_t>(size), '\0');
+        if (WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, wide_argv[i], -1,
+                                argument.data(), size, nullptr, nullptr) == 0) {
+            std::fprintf(stderr, "error: could not encode command-line argument as UTF-8\n");
+            return EXIT_FAILURE;
+        }
+        argument.pop_back(); // Drop the NUL counted by the conversion API.
+        utf8_args.push_back(std::move(argument));
+    }
+    std::vector<char *> argv_storage;
+    argv_storage.reserve(argc + 1);
+    for (auto & argument : utf8_args) {
+        argv_storage.push_back(argument.data());
+    }
+    argv_storage.push_back(nullptr);
+    char ** argv = argv_storage.data();
